{application, my_gleam_webserver,
 [{description, "A Gleam/Cowboy HTTP server with graceful shutdown"},
  {vsn, "1.0.0"},
  {applications,
   [kernel,
    stdlib,
    cowboy,
    gleam_stdlib,
    gleam_erlang,
    gleam_http,
    gleam_cowboy
   ]},
  {mod, {my_gleam_webserver_app, []}},
  {env, []}
 ]}.
